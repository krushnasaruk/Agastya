  "components": {
    "schemas": {
      "FaultInjectionRequest": {
        "properties": {
          "fault_type": {
            "type": "string",
            "title": "Fault Type",
            "description": "gps_jamming, accel_bias_jump, gyro_bias_jump, vo_dropout"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value",
            "default": 1.0
          },
          "duration_sec": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Sec",
            "default": 10.0
          }
        },
        "type": "object",
        "required": [
          "fault_type"
        ],
        "title": "FaultInjectionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ModeChangeRequest": {
        "properties": {
          "mode": {
            "type": "string",
            "title": "Mode",
            "description": "Operating mode: ai_enhanced_ekf, classical_ekf, pure_dr, ai_only"
          }
        },
        "type": "object",
        "required": [
          "mode"
        ],
        "title": "ModeChangeRequest"
      },
      "ScenarioInfoSchema": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "duration_sec": {
            "type": "number",
            "title": "Duration Sec"
          },
          "trajectory_type": {
            "type": "string",
            "title": "Trajectory Type"
          },
          "speed_mps": {
            "type": "number",
            "title": "Speed Mps"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "duration_sec",
          "trajectory_type",
          "speed_mps"
        ],
        "title": "ScenarioInfoSchema"
      },
      "SimulationSpeedRequest": {
        "properties": {
          "speed_multiplier": {
            "type": "number",
            "maximum": 20.0,
            "minimum": 0.1,
            "title": "Speed Multiplier",
            "default": 1.0
          }
        },
        "type": "object",
        "title": "SimulationSpeedRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
