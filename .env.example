# API & Telemetry Server
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Simulation & Navigation Engine
SIM_RATE_HZ=100
TELEMETRY_STREAM_HZ=50
DEFAULT_SCENARIO=gps_loss.json

# ML Subsystem
ML_MODEL_TYPE=bilstm
ML_MODEL_WEIGHTS_PATH=services/ml/models/bilstm_dead_reckoning.pt
ML_DEVICE=cpu
SEQUENCE_WINDOW_SIZE=100
FEATURE_DIM=6

# Logging
LOG_LEVEL=INFO
